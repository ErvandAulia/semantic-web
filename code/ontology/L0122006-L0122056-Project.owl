                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">100000.0</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
