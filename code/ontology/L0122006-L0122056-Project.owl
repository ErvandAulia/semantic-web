                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#nilaiHarga"/>
                        <owl:someValuesFrom>
