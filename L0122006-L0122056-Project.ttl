###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#PerusahaanRestoran
:PerusahaanRestoran rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Swasta
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :mengelola ;
                                                                 owl:someValuesFrom :Restoran
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :Swasta .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Rating
:Rating rdf:type owl:Class ;
        rdfs:comment "Ini adalah class untuk memberikan nilai Rating berdasarkan Google" .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RatingEvent
:RatingEvent rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Rating
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :ratingDari ;
                                                          owl:someValuesFrom :Event
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :nilaiRating ;
                                                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                               owl:onDatatype xsd:float ;
                                                                               owl:withRestrictions ( [ xsd:minInclusive "1.0"^^xsd:float
                                                                                                      ]
                                                                                                      [ xsd:maxInclusive "5.0"^^xsd:float
                                                                                                      ]
                                                                                                    )
                                                                             ]
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :Rating .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RatingHotel
:RatingHotel rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Rating
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :ratingDari ;
                                                          owl:someValuesFrom :Hotel
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :nilaiRating ;
                                                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                               owl:onDatatype xsd:float ;
                                                                               owl:withRestrictions ( [ xsd:minInclusive "1.0"^^xsd:float
                                                                                                      ]
                                                                                                      [ xsd:maxInclusive "5.0"^^xsd:float
                                                                                                      ]
                                                                                                    )
                                                                             ]
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :Rating .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RatingRestoran
:RatingRestoran rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Rating
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :ratingDari ;
                                                             owl:someValuesFrom :Restoran
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :nilaiRating ;
                                                             owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                  owl:onDatatype xsd:float ;
                                                                                  owl:withRestrictions ( [ xsd:minInclusive "1.0"^^xsd:float
                                                                                                         ]
                                                                                                         [ xsd:maxInclusive "5.0"^^xsd:float
                                                                                                         ]
                                                                                                       )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Rating .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RatingTempatWisata
:RatingTempatWisata rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Rating
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :ratingDari ;
                                                                 owl:someValuesFrom :TempatWisata
                                                               ]
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :nilaiRating ;
                                                                 owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                      owl:onDatatype xsd:float ;
                                                                                      owl:withRestrictions ( [ xsd:minInclusive "1.0"^^xsd:float
                                                                                                             ]
                                                                                                             [ xsd:maxInclusive "5.0"^^xsd:float
                                                                                                             ]
                                                                                                           )
                                                                                    ]
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :Rating .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Regulasi
:Regulasi rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :diBuatOleh ;
                            owl:someValuesFrom :PemangkuKepentingan
                          ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RegulasiPariwisata
:RegulasiPariwisata rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Regulasi
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :mengacuPada ;
                                                                 owl:someValuesFrom :UUPariwisata
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :Regulasi ;
                    owl:disjointWith :RegulasiPerizinan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RegulasiPerizinan
:RegulasiPerizinan rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :Regulasi
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :mengacuPada ;
                                                                owl:someValuesFrom :UUPerizinan
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf :Regulasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Restoran
:Restoran rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :berlokasiDi ;
                            owl:someValuesFrom :Lokasi
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :memilikiFasilitas ;
                            owl:someValuesFrom :FasilitasUmum
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :memilikiHarga ;
                            owl:someValuesFrom :HargaMakanan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :memilikiWaktuBuka ;
                            owl:someValuesFrom :WaktuBukaHarian
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :memilikiWaktuTutup ;
                            owl:someValuesFrom :WaktuTutupHarian
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :memilikiRating ;
                            owl:allValuesFrom :RatingRestoran
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :namaRestoran ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RestoranCepatSaji
:RestoranCepatSaji rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :Restoran
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :menghidangkan ;
                                                                owl:someValuesFrom :MakananCepatSaji
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf :Restoran .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RestoranMahal
:RestoranMahal rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Restoran
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :memilikiHarga ;
                                                            owl:someValuesFrom :Mahal
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :Restoran .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RestoranMurah
:RestoranMurah rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Restoran
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :memilikiHarga ;
                                                            owl:someValuesFrom :Murah
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :Restoran .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RestoranPopuler
:RestoranPopuler rdf:type owl:Class ;
                 rdfs:subClassOf :Restoran .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#RestoranTradisional
:RestoranTradisional rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :Restoran
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :menghidangkan ;
                                                                  owl:someValuesFrom :MakananTradisional
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf :Restoran .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Sedang
:Sedang rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :HargaMakanan
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :nilaiHarga ;
                                                     owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                          owl:onDatatype xsd:float ;
                                                                          owl:withRestrictions ( [ xsd:minInclusive "25000.0"^^xsd:float
                                                                                                 ]
                                                                                               )
                                                                        ]
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :nilaiHarga ;
                                                     owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                          owl:onDatatype xsd:float ;
                                                                          owl:withRestrictions ( [ xsd:maxInclusive "100000.0"^^xsd:float
                                                                                                 ]
                                                                                               )
                                                                        ]
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :HargaMakanan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Swasta
:Swasta rdf:type owl:Class ;
        rdfs:subClassOf :PemangkuKepentingan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#TempatWisata
:TempatWisata rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiFasilitas ;
                                owl:someValuesFrom :FasilitasUmum
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiHarga ;
                                owl:someValuesFrom :HargaTiket
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiWaktuBuka ;
                                owl:someValuesFrom :WaktuBukaHarian
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiWaktuTutup ;
                                owl:someValuesFrom :WaktuTutupHarian
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiRating ;
                                owl:allValuesFrom :RatingTempatWisata
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiFasilitas ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :FasilitasUmum
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :berlokasiDi ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Lokasi
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :namaTempat ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Transportasi
:Transportasi rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiHarga ;
                                owl:someValuesFrom :HargaTransportasi
                              ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#TransportasiOnline
:TransportasiOnline rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Transportasi
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :dipesanMelalui ;
                                                                 owl:someValuesFrom :Aplikasi
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :Transportasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#TransportasiUmum
:TransportasiUmum rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :Transportasi
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :memilikiWaktuBuka ;
                                                               owl:someValuesFrom :WaktuBukaHarian
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :memilikiWaktuTutup ;
                                                               owl:someValuesFrom :WaktuTutupHarian
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :Transportasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#TujuanFasilitas
:TujuanFasilitas rdf:type owl:Class ;
                 rdfs:comment "Class untuk mengkategorikan tujuan Fasilitas yang disediakan" .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#TutupMalam
:TutupMalam rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :WaktuTutupHarian
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :jamTutup ;
                                                         owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                              owl:onDatatype xsd:int ;
                                                                              owl:withRestrictions ( [ xsd:minInclusive "1900"^^xsd:int
                                                                                                     ]
                                                                                                     [ xsd:maxInclusive "2359"^^xsd:int
                                                                                                     ]
                                                                                                   )
                                                                            ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :WaktuTutupHarian .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#TutupPagi
:TutupPagi rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :WaktuTutupHarian
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :jamTutup ;
                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                             owl:onDatatype xsd:int ;
                                                                             owl:withRestrictions ( [ xsd:minInclusive "0001"^^xsd:int
                                                                                                    ]
                                                                                                    [ xsd:maxInclusive "1059"^^xsd:int
                                                                                                    ]
                                                                                                  )
                                                                           ]
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :WaktuTutupHarian .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#TutupSiang
:TutupSiang rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :WaktuTutupHarian
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :jamTutup ;
                                                         owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                              owl:onDatatype xsd:int ;
                                                                              owl:withRestrictions ( [ xsd:minInclusive "1059"^^xsd:int
                                                                                                     ]
                                                                                                     [ xsd:maxInclusive "1500"^^xsd:int
                                                                                                     ]
                                                                                                   )
                                                                            ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :WaktuTutupHarian .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#TutupSore
:TutupSore rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :WaktuTutupHarian
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :jamTutup ;
                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                             owl:onDatatype xsd:int ;
                                                                             owl:withRestrictions ( [ xsd:minInclusive "1501"^^xsd:int
                                                                                                    ]
                                                                                                    [ xsd:maxInclusive "1859"^^xsd:int
                                                                                                    ]
                                                                                                  )
                                                                           ]
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :WaktuTutupHarian .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#UUPariwisata
:UUPariwisata rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :UndangUndang
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :membahasPeraturan ;
                                                           owl:hasValue "pariwisata"
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :UndangUndang ;
              owl:disjointWith :UUPerizinan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#UUPerizinan
:UUPerizinan rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :UndangUndang
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :membahasPeraturan ;
                                                          owl:hasValue "perizinan"
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :UndangUndang .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Umum
:Umum rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :TujuanFasilitas
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :tujuanLayanan ;
                                                   owl:hasValue "umum"
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf :TujuanFasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#UndangUndang
:UndangUndang rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :membahasPeraturan ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WaktuBukaHarian
:WaktuBukaHarian rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :jamBuka ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:integer
                                 ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WaktuTutupHarian
:WaktuTutupHarian rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :jamTutup ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:integer
                                  ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WisataAlam
:WisataAlam rdf:type owl:Class ;
            rdfs:subClassOf :TempatWisata .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WisataBudaya
:WisataBudaya rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :TempatWisata
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :menyelenggarakan ;
                                                           owl:someValuesFrom :EventBudaya
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :TempatWisata .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WisataEdukasi
:WisataEdukasi rdf:type owl:Class ;
               rdfs:subClassOf :TempatWisata .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WisataKuliner
:WisataKuliner rdf:type owl:Class ;
               rdfs:subClassOf :TempatWisata .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WisataPopuler
:WisataPopuler rdf:type owl:Class ;
               rdfs:subClassOf :TempatWisata .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WisataReligi
:WisataReligi rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :TempatWisata
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :menyelenggarakan ;
                                                           owl:someValuesFrom :EventReligi
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :TempatWisata .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#WisataSejarah
:WisataSejarah rdf:type owl:Class ;
               rdfs:subClassOf :TempatWisata .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#AksesKursiRoda
:AksesKursiRoda rdf:type owl:NamedIndividual ,
                         :Fasilitas ;
                :melayaniTujuan :FasilitasKhusus ;
                :aksesDisabilitas "true"^^xsd:boolean .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#AplikasiGojek
:AplikasiGojek rdf:type owl:NamedIndividual ,
                        :Aplikasi ;
               :memprosesPesanan :GoFood ,
                                 :GoRide .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#AreaBermainAnak
:AreaBermainAnak rdf:type owl:NamedIndividual ,
                          :Fasilitas ;
                 :melayaniTujuan :FasilitasAnak .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Banjarsari
:Banjarsari rdf:type owl:NamedIndividual ,
                     :Lokasi ;
            :merupakanBagianDari :KotaSurakarta .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BatikSoloTrans
:BatikSoloTrans rdf:type owl:NamedIndividual ,
                         :Transportasi ;
                :dimilikiOleh :PemkotSurakarta ;
                :memilikiHarga :HargaBst ;
                :memilikiWaktuBuka :WaktuBukaBST ;
                :memilikiWaktuTutup :WaktuTutupBST .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BukitSekipan
:BukitSekipan rdf:type owl:NamedIndividual ,
