@prefix : <http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#> .

<http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#berjarakDengan
:berjarakDengan rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Hotel
                                            :Restoran
                                            :TempatWisata
                                          )
                            ] ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :Hotel
                                           :Restoran
                                           :TempatWisata
                                         )
                           ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#berkepentinganPada
:berkepentinganPada rdf:type owl:ObjectProperty ;
                    rdfs:domain :PemangkuKepentingan ;
                    rdfs:range :TempatWisata .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#berlokasiDi
:berlokasiDi rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Event
                                         :Hotel
                                         :Restoran
                                         :TempatWisata
                                       )
                         ] ;
             rdfs:range :Lokasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dekatDenganHotel
:dekatDenganHotel rdf:type owl:ObjectProperty ;
                  rdfs:domain :TempatWisata ;
                  rdfs:range :Hotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dekatDenganRestoran
:dekatDenganRestoran rdf:type owl:ObjectProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Hotel
                                                 :TempatWisata
                                               )
                                 ] ;
                     rdfs:range :Restoran .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dekatDenganTransportasi
:dekatDenganTransportasi rdf:type owl:ObjectProperty ;
                         owl:inverseOf :dilaluiOlehTransportasi ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :Hotel
                                                     :TempatWisata
                                                   )
                                     ] ;
                         rdfs:range :Transportasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#diBuatOleh
:diBuatOleh rdf:type owl:ObjectProperty ;
            rdfs:domain :Regulasi ;
            rdfs:range :PemangkuKepentingan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#digunakanOleh
:digunakanOleh rdf:type owl:ObjectProperty ;
               owl:inverseOf :memilikiFasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dilaluiOlehTransportasi
:dilaluiOlehTransportasi rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dimilikiOleh
:dimilikiOleh rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Hotel
                                          :Restoran
                                          :TempatWisata
                                          :Transportasi
                                        )
                          ] ;
              rdfs:range :PemangkuKepentingan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dipesanMelalui
:dipesanMelalui rdf:type owl:ObjectProperty ;
                owl:inverseOf :memprosesPesanan ;
                rdfs:range :Aplikasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#melayaniTujuan
:melayaniTujuan rdf:type owl:ObjectProperty ;
                rdfs:domain :Fasilitas ;
                rdfs:range :TujuanFasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiBagian
:memilikiBagian rdf:type owl:ObjectProperty ;
                owl:inverseOf :merupakanBagianDari .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiFasilitas
:memilikiFasilitas rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Hotel
                                               :Restoran
                                               :TempatWisata
                                             )
                               ] ;
                   rdfs:range :Fasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiHarga
:memilikiHarga rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :Event
                                           :Hotel
                                           :Restoran
                                           :TempatWisata
                                           :Transportasi
                                         )
                           ] ;
               rdfs:range :Harga .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiHargaMakanan
:memilikiHargaMakanan rdf:type owl:ObjectProperty ;
                      rdfs:domain :Makanan ;
                      rdfs:range :HargaMakanan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiKategoriMakanan
:memilikiKategoriMakanan rdf:type owl:ObjectProperty ;
                         rdfs:domain :Makanan ;
                         rdfs:range :KategoriMakanan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiPeringkat
:memilikiPeringkat rdf:type owl:ObjectProperty ;
                   rdfs:domain :Hotel ;
                   rdfs:range :PeringkatHotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiRating
:memilikiRating rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Event
                                            :Hotel
                                            :Restoran
                                            :TempatWisata
                                          )
                            ] ;
                rdfs:range :Rating .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiWaktuBuka
:memilikiWaktuBuka rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Event
                                               :Hotel
                                               :Restoran
                                               :TempatWisata
                                               :Transportasi
                                             )
                               ] ;
                   rdfs:range :WaktuBukaHarian .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiWaktuTutup
:memilikiWaktuTutup rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Event
                                                :Hotel
                                                :Restoran
                                                :TempatWisata
                                                :Transportasi
                                              )
                                ] ;
                    rdfs:range :WaktuTutupHarian .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memprosesPesanan
:memprosesPesanan rdf:type owl:ObjectProperty ;
                  rdfs:domain :Aplikasi ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( :Aplikasi
                                             :Restoran
                                             :Transportasi
                                           )
                             ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#mengacuPada
:mengacuPada rdf:type owl:ObjectProperty ;
             rdfs:domain :Regulasi ;
             rdfs:range :UndangUndang .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#mengatur
:mengatur rdf:type owl:ObjectProperty ;
          rdfs:domain :PemangkuKepentingan ;
          rdfs:range :Regulasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#mengelola
:mengelola rdf:type owl:ObjectProperty ;
           rdfs:domain :PemangkuKepentingan ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Event
                                      :Hotel
                                      :Restoran
                                      :TempatWisata
                                    )
                      ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#menghidangkan
:menghidangkan rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :KategoriMakanan
                                           :Restoran
                                         )
                           ] ;
               rdfs:range :Makanan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#menikmati
:menikmati rdf:type owl:ObjectProperty ;
           rdfs:domain :PemangkuKepentingan ;
           rdfs:range :TempatWisata .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#menjadiDasar
:menjadiDasar rdf:type owl:ObjectProperty ;
              rdfs:domain :UndangUndang ;
              rdfs:range :Regulasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#menyelenggarakan
:menyelenggarakan rdf:type owl:ObjectProperty ;
                  rdfs:domain :TempatWisata ;
                  rdfs:range :Event .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#merupakanBagianDari
:merupakanBagianDari rdf:type owl:ObjectProperty ,
                              owl:TransitiveProperty ;
                     rdfs:domain :Lokasi ;
                     rdfs:range :Lokasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#peringkatHotel
:peringkatHotel rdf:type owl:ObjectProperty ;
                rdfs:domain :Hotel ;
                rdfs:range :PeringkatHotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#ratingDari
:ratingDari rdf:type owl:ObjectProperty ;
            rdfs:domain :Rating ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :Event
                                       :Hotel
                                       :Restoran
                                       :TempatWisata
                                     )
                       ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#terletakDi
:terletakDi rdf:type owl:ObjectProperty ;
            rdfs:domain :Event ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :Lokasi
                                       :TempatWisata
                                     )
                       ] .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#aksesDisabilitas
:aksesDisabilitas rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:boolean .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#alamat
:alamat rdf:type owl:DatatypeProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Hotel
                                    :Lokasi
                                    :Restoran
                                    :TempatWisata
                                  )
                    ] ;
        rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#bintangHotel
:bintangHotel rdf:type owl:DatatypeProperty ;
              rdfs:domain :PeringkatHotel ;
              rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#deskripsiTempat
:deskripsiTempat rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :TempatWisata ;
                 rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#hariBuka
:hariBuka rdf:type owl:DatatypeProperty ;
          rdfs:domain :WaktuBukaHarian ;
          rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#jamBuka
:jamBuka rdf:type owl:DatatypeProperty ;
         rdfs:domain :WaktuBukaHarian ;
         rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#jamTutup
:jamTutup rdf:type owl:DatatypeProperty ;
          rdfs:domain :WaktuTutupHarian ;
          rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#jumlahUlasan
:jumlahUlasan rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Rating ;
              rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#kapasitasPengunjung
:kapasitasPengunjung rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :TempatWisata ;
                     rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#kategoriDayaTarik
:kategoriDayaTarik rdf:type owl:DatatypeProperty ;
                   rdfs:domain :TempatWisata ;
                   rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#kategoriEvent
:kategoriEvent rdf:type owl:DatatypeProperty ;
               rdfs:domain :Event ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#kategoriHarga
:kategoriHarga rdf:type owl:DatatypeProperty ;
               rdfs:domain :Harga ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#kategoriMakanan
:kategoriMakanan rdf:type owl:DatatypeProperty ;
                 rdfs:domain :KategoriMakanan ;
                 rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#komentarRating
:komentarRating rdf:type owl:DatatypeProperty ;
                rdfs:domain :Rating ;
                rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#membahasPeraturan
:membahasPeraturan rdf:type owl:DatatypeProperty ;
                   rdfs:domain :UndangUndang ;
                   rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaAplikasi
:namaAplikasi rdf:type owl:DatatypeProperty ;
              rdfs:domain :Aplikasi ;
              rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaEvent
:namaEvent rdf:type owl:DatatypeProperty ;
           rdfs:domain :Event ;
           rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaFasilitas
:namaFasilitas rdf:type owl:DatatypeProperty ;
               rdfs:domain :Fasilitas ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaHotel
:namaHotel rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Hotel ;
           rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaRestoran
:namaRestoran rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Restoran ;
              rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaTempat
:namaTempat rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :TempatWisata ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#nilaiHarga
:nilaiHarga rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :HargaMakanan
                                        :HargaTransportasi
                                      )
                        ] ;
            rdfs:range xsd:float .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#nilaiRating
:nilaiRating rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Rating ;
             rdfs:range xsd:float .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#satuanHarga
:satuanHarga rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Harga ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#tanggalEvent
:tanggalEvent rdf:type owl:DatatypeProperty ;
              rdfs:domain :Event ;
              rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#tujuanLayanan
:tujuanLayanan rdf:type owl:DatatypeProperty ;
               rdfs:domain :TujuanFasilitas ;
               rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Anak
:Anak rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :TujuanFasilitas
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :tujuanLayanan ;
                                                   owl:hasValue "anak"
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf :TujuanFasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Aplikasi
:Aplikasi rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :memprosesPesanan ;
                            owl:someValuesFrom :Transportasi
                          ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#AplikasiTransportasi
:AplikasiTransportasi rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Aplikasi
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :memprosesPesanan ;
                                                                   owl:someValuesFrom :TransportasiOnline
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf :Aplikasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BintangEmpat
:BintangEmpat rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :PeringkatHotel
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :bintangHotel ;
                                                           owl:hasValue 4
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :PeringkatHotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BintangLima
:BintangLima rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :PeringkatHotel
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :bintangHotel ;
                                                          owl:hasValue 5
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :PeringkatHotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BintangTiga
:BintangTiga rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :PeringkatHotel
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :bintangHotel ;
                                                          owl:hasValue 3
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :PeringkatHotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BukaMalam
:BukaMalam rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :WaktuBukaHarian
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :jamBuka ;
                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                             owl:onDatatype xsd:int ;
                                                                             owl:withRestrictions ( [ xsd:minInclusive "1900"^^xsd:int
                                                                                                    ]
                                                                                                    [ xsd:maxInclusive "2359"^^xsd:int
                                                                                                    ]
                                                                                                  )
                                                                           ]
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :WaktuBukaHarian .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BukaPagi
:BukaPagi rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :WaktuBukaHarian
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :jamBuka ;
                                                       owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                            owl:onDatatype xsd:int ;
                                                                            owl:withRestrictions ( [ xsd:minInclusive "500"^^xsd:int
                                                                                                   ]
                                                                                                   [ xsd:maxInclusive "1059"^^xsd:int
                                                                                                   ]
                                                                                                 )
                                                                          ]
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf :WaktuBukaHarian .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BukaSiang
:BukaSiang rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :WaktuBukaHarian
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :jamBuka ;
                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                             owl:onDatatype xsd:int ;
                                                                             owl:withRestrictions ( [ xsd:minInclusive "1100"^^xsd:int
                                                                                                    ]
                                                                                                    [ xsd:maxInclusive "1500"^^xsd:int
                                                                                                    ]
                                                                                                  )
                                                                           ]
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :WaktuBukaHarian .


