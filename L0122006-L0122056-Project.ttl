#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :EventOrganizer
                :PerusahaanHotel
                :PerusahaanRestoran
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :HargaKamar
                :HargaMakanan
                :HargaTiket
                :HargaTransportasi
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :HotelBintangEmpat
                :HotelBintangLima
                :HotelBintangTiga
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :KategoriCepatSaji
                :KategoriModern
                :KategoriTradisional
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Mahal
                :Murah
                :Sedang
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Masyarakat
                :Pemerintah
                :Swasta
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :RatingEvent
                :RatingHotel
                :RatingRestoran
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :RatingEvent
                :RatingHotel
                :RatingTempatWisata
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :TutupMalam
                :TutupPagi
                :TutupSiang
                :TutupSore
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :WisataAlam
                :WisataBudaya
                :WisataEdukasi
                :WisataKuliner
                :WisataReligi
                :WisataSejarah
              )
] .


#################################################################
#    Rules
#################################################################

:m rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:h rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:v rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:res rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:r rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:n rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:t rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:k rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:w rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:j rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Price classification for HargaMakanan -> Mahal" ;
   rdfs:label "S4" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Makanan ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :m
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :memilikiHarga ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :m ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :h
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :nilaiHarga ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :h ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :v
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#greaterThan> ;
                                                                                        <http://www.w3.org/2003/11/swrl#arguments> [ rdf:type rdf:List ;
                                                                                                                                     rdf:first :v ;
                                                                                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                rdf:first 100000.0 ;
                                                                                                                                                rdf:rest rdf:nil
                                                                                                                                              ]
                                                                                                                                   ]
                                                                                      ] ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Mahal ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :m
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Price classification for HargaMakanan -> Murah" ;
   rdfs:label "S3" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Makanan ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :m
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :memilikiHarga ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :m ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :h
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :nilaiHarga ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :h ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :v
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#lessThan> ;
                                                                                        <http://www.w3.org/2003/11/swrl#arguments> [ rdf:type rdf:List ;
                                                                                                                                     rdf:first :v ;
                                                                                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                rdf:first 25000.0 ;
                                                                                                                                                rdf:rest rdf:nil
                                                                                                                                              ]
                                                                                                                                   ]
                                                                                      ] ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Murah ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :m
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Rating classification for Restoran" ;
   rdfs:label "S2" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
