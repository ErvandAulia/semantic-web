@prefix : <http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix l0122006-l0122056-project: <http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#> .
@base <http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/> .

<http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project> rdf:type owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#berlokasiDi
l0122006-l0122056-project:berlokasiDi rdf:type owl:ObjectProperty ,
                                               owl:FunctionalProperty ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( :Event
                                                                  :Hotel
                                                                  :Restoran
                                                                  :TempatWisata
                                                                )
                                                  ] ;
                                      rdfs:range :Lokasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#digunakanOleh
l0122006-l0122056-project:digunakanOleh rdf:type owl:ObjectProperty ;
                                        owl:inverseOf :memilikiFasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dilaluiOlehTransportasi
l0122006-l0122056-project:dilaluiOlehTransportasi rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf :dekatDenganTransportasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dimilikiOleh
l0122006-l0122056-project:dimilikiOleh rdf:type owl:ObjectProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( :Hotel
                                                                   :Restoran
                                                                   :TempatWisata
                                                                   :Transportasi
                                                                 )
                                                   ] ;
                                       rdfs:range l0122006-l0122056-project:PemangkuKepentingan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#dipesanMelalui
l0122006-l0122056-project:dipesanMelalui rdf:type owl:ObjectProperty ;
                                         owl:inverseOf l0122006-l0122056-project:memprosesPesanan ;
                                         rdfs:range l0122006-l0122056-project:Aplikasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#melayaniTujuan
l0122006-l0122056-project:melayaniTujuan rdf:type owl:ObjectProperty ;
                                         rdfs:domain :Fasilitas ;
                                         rdfs:range l0122006-l0122056-project:TujuanFasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiBagian
l0122006-l0122056-project:memilikiBagian rdf:type owl:ObjectProperty ;
                                         owl:inverseOf l0122006-l0122056-project:merupakanBagianDari .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiDayaTarik
l0122006-l0122056-project:memilikiDayaTarik rdf:type owl:ObjectProperty ;
                                            rdfs:domain :TempatWisata ;
                                            rdfs:range l0122006-l0122056-project:DayaTarik .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiHargaMakanan
l0122006-l0122056-project:memilikiHargaMakanan rdf:type owl:ObjectProperty ;
                                               rdfs:domain l0122006-l0122056-project:Makanan ;
                                               rdfs:range :HargaMakanan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memilikiKategoriMakanan
l0122006-l0122056-project:memilikiKategoriMakanan rdf:type owl:ObjectProperty ;
                                                  rdfs:domain l0122006-l0122056-project:Makanan ;
                                                  rdfs:range l0122006-l0122056-project:KategoriMakanan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#memprosesPesanan
l0122006-l0122056-project:memprosesPesanan rdf:type owl:ObjectProperty ;
                                           rdfs:domain l0122006-l0122056-project:Aplikasi ;
                                           rdfs:range [ rdf:type owl:Class ;
                                                        owl:unionOf ( l0122006-l0122056-project:Aplikasi
                                                                      :Restoran
                                                                      :Transportasi
                                                                    )
                                                      ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#menghidangkan
l0122006-l0122056-project:menghidangkan rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf owl:topObjectProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( l0122006-l0122056-project:KategoriMakanan
                                                                    :Restoran
                                                                  )
                                                    ] ;
                                        rdfs:range l0122006-l0122056-project:Makanan .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#merupakanBagianDari
l0122006-l0122056-project:merupakanBagianDari rdf:type owl:ObjectProperty ,
                                                       owl:TransitiveProperty ;
                                              rdfs:domain :Lokasi ;
                                              rdfs:range :Lokasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#ratingDari
l0122006-l0122056-project:ratingDari rdf:type owl:ObjectProperty ;
                                     rdfs:domain :Rating ;
                                     rdfs:range [ rdf:type owl:Class ;
                                                  owl:unionOf ( :Event
                                                                :Restoran
                                                                :TempatWisata
                                                              )
                                                ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#terletakDi
l0122006-l0122056-project:terletakDi rdf:type owl:ObjectProperty ;
                                     rdfs:domain :Event ;
                                     rdfs:range [ rdf:type owl:Class ;
                                                  owl:unionOf ( :Lokasi
                                                                :TempatWisata
                                                              )
                                                ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/berjarakDengan
:berjarakDengan rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Hotel
                                            :Restoran
                                            :TempatWisata
                                          )
                            ] ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :Hotel
                                           :Restoran
                                           :TempatWisata
                                         )
                           ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/dekatDenganHotel
:dekatDenganHotel rdf:type owl:ObjectProperty ;
                  rdfs:domain :TempatWisata ;
                  rdfs:range :Hotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/dekatDenganRestoran
:dekatDenganRestoran rdf:type owl:ObjectProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Hotel
                                                 :TempatWisata
                                               )
                                 ] ;
                     rdfs:range :Restoran .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/dekatDenganTransportasi
:dekatDenganTransportasi rdf:type owl:ObjectProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :Hotel
                                                     :TempatWisata
                                                   )
                                     ] ;
                         rdfs:range :Transportasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/memilikiFasilitas
:memilikiFasilitas rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Hotel
                                               :Restoran
                                               :TempatWisata
                                             )
                               ] ;
                   rdfs:range :Fasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/memilikiHarga
:memilikiHarga rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :Event
                                           :Hotel
                                           :Restoran
                                           :TempatWisata
                                           :Transportasi
                                         )
                           ] ;
               rdfs:range :Harga .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/memilikiRating
:memilikiRating rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Event
                                            :Hotel
                                            :Restoran
                                            :TempatWisata
                                          )
                            ] ;
                rdfs:range :Rating .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/memilikiWaktuOperasional
:memilikiWaktuOperasional rdf:type owl:ObjectProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :Event
                                                      :Hotel
                                                      :Restoran
                                                      :TempatWisata
                                                      :Transportasi
                                                    )
                                      ] ;
                          rdfs:range :WaktuOperasional .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/menyelenggarakan
:menyelenggarakan rdf:type owl:ObjectProperty ;
                  rdfs:domain :TempatWisata ;
                  rdfs:range :Event .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#aksesDisabilitas
l0122006-l0122056-project:aksesDisabilitas rdf:type owl:DatatypeProperty ;
                                           rdfs:range xsd:boolean .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#kategoriEvent
l0122006-l0122056-project:kategoriEvent rdf:type owl:DatatypeProperty ;
                                        rdfs:domain :Event ;
                                        rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaAplikasi
l0122006-l0122056-project:namaAplikasi rdf:type owl:DatatypeProperty ;
                                       rdfs:domain l0122006-l0122056-project:Aplikasi ;
                                       rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaEvent
l0122006-l0122056-project:namaEvent rdf:type owl:DatatypeProperty ;
                                    rdfs:domain :Event ;
                                    rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#namaRestoran
l0122006-l0122056-project:namaRestoran rdf:type owl:DatatypeProperty ,
                                                owl:FunctionalProperty ;
                                       rdfs:domain :Restoran ;
                                       rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/alamat
:alamat rdf:type owl:DatatypeProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Hotel
                                    :Lokasi
                                    :Restoran
                                    :TempatWisata
                                  )
                    ] ;
        rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/deskripsiTempat
:deskripsiTempat rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :TempatWisata ;
                 rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/hariBuka
:hariBuka rdf:type owl:DatatypeProperty ;
          rdfs:domain :WaktuOperasional ;
          rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/jamBuka
:jamBuka rdf:type owl:DatatypeProperty ;
         rdfs:domain :WaktuOperasional ;
         rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/jamTutup
:jamTutup rdf:type owl:DatatypeProperty ;
          rdfs:domain :WaktuOperasional ;
          rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/jumlahUlasan
:jumlahUlasan rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Rating ;
              rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/kapasitasPengunjung
:kapasitasPengunjung rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :TempatWisata ;
                     rdfs:range xsd:integer .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/komentarRating
:komentarRating rdf:type owl:DatatypeProperty ;
                rdfs:domain :Rating ;
                rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/namaFasilitas
:namaFasilitas rdf:type owl:DatatypeProperty ;
               rdfs:domain :Fasilitas ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/namaHotel
:namaHotel rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Hotel ;
           rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/namaTempat
:namaTempat rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :TempatWisata ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/nilaiHarga
:nilaiHarga rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :HargaMakanan
                                        :HargaTransportasi
                                      )
                        ] ;
            rdfs:range xsd:float .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/nilaiRating
:nilaiRating rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Rating ;
             rdfs:range xsd:float .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/satuanHarga
:satuanHarga rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Harga ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/acer/ontologies/2025/10/untitled-ontology-9/tanggalEvent
:tanggalEvent rdf:type owl:DatatypeProperty ;
              rdfs:domain :Event ;
              rdfs:range xsd:date .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#AirTerjun
l0122006-l0122056-project:AirTerjun rdf:type owl:Class ;
                                    rdfs:subClassOf l0122006-l0122056-project:DayaTarikAlam .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Anak
l0122006-l0122056-project:Anak rdf:type owl:Class ;
                               rdfs:subClassOf l0122006-l0122056-project:TujuanFasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Aplikasi
l0122006-l0122056-project:Aplikasi rdf:type owl:Class ;
                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty l0122006-l0122056-project:memprosesPesanan ;
                                                     owl:someValuesFrom :Transportasi
                                                   ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#AplikasiTransportasi
l0122006-l0122056-project:AplikasiTransportasi rdf:type owl:Class ;
                                               owl:equivalentClass [ owl:intersectionOf ( l0122006-l0122056-project:Aplikasi
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty l0122006-l0122056-project:memprosesPesanan ;
                                                                                            owl:someValuesFrom :TransportasiOnline
                                                                                          ]
                                                                                        ) ;
                                                                     rdf:type owl:Class
                                                                   ] ;
                                               rdfs:subClassOf l0122006-l0122056-project:Aplikasi .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BintangEmpat
l0122006-l0122056-project:BintangEmpat rdf:type owl:Class ;
                                       rdfs:subClassOf :RatingHotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BintangLima
l0122006-l0122056-project:BintangLima rdf:type owl:Class ;
                                      rdfs:subClassOf :RatingHotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#BintangTiga
l0122006-l0122056-project:BintangTiga rdf:type owl:Class ;
                                      rdfs:subClassOf :RatingHotel .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Bukit
l0122006-l0122056-project:Bukit rdf:type owl:Class ;
                                rdfs:subClassOf l0122006-l0122056-project:DayaTarikAlam .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#DayaTarik
l0122006-l0122056-project:DayaTarik rdf:type owl:Class ;
                                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                      owl:onProperty l0122006-l0122056-project:berlokasiDi ;
                                                      owl:someValuesFrom :Lokasi
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :memilikiFasilitas ;
                                                      owl:someValuesFrom :Fasilitas
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :memilikiRating ;
                                                      owl:someValuesFrom :Rating
                                                    ] .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#DayaTarikAlam
l0122006-l0122056-project:DayaTarikAlam rdf:type owl:Class ;
                                        rdfs:subClassOf l0122006-l0122056-project:DayaTarik .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#DayaTarikEdukasi
l0122006-l0122056-project:DayaTarikEdukasi rdf:type owl:Class ;
                                           rdfs:subClassOf l0122006-l0122056-project:DayaTarik .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#DayaTarikKuliner
l0122006-l0122056-project:DayaTarikKuliner rdf:type owl:Class ;
                                           rdfs:subClassOf l0122006-l0122056-project:DayaTarik .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#DayaTarikReligi
l0122006-l0122056-project:DayaTarikReligi rdf:type owl:Class ;
                                          rdfs:subClassOf l0122006-l0122056-project:DayaTarik .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#DayaTarikSejarah
l0122006-l0122056-project:DayaTarikSejarah rdf:type owl:Class ;
                                           rdfs:subClassOf l0122006-l0122056-project:DayaTarik .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Edukasi
l0122006-l0122056-project:Edukasi rdf:type owl:Class ;
                                  rdfs:subClassOf l0122006-l0122056-project:TujuanFasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#FasilitasAkomodasi
l0122006-l0122056-project:FasilitasAkomodasi rdf:type owl:Class ;
                                             owl:equivalentClass [ owl:intersectionOf ( :Fasilitas
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty l0122006-l0122056-project:digunakanOleh ;
                                                                                          owl:someValuesFrom :Hotel
                                                                                        ]
                                                                                      ) ;
                                                                   rdf:type owl:Class
                                                                 ] ;
                                             rdfs:subClassOf :Fasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#FasilitasAnak
l0122006-l0122056-project:FasilitasAnak rdf:type owl:Class ;
                                        owl:equivalentClass [ owl:intersectionOf ( :Fasilitas
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty l0122006-l0122056-project:melayaniTujuan ;
                                                                                     owl:someValuesFrom l0122006-l0122056-project:Anak
                                                                                   ]
                                                                                 ) ;
                                                              rdf:type owl:Class
                                                            ] ;
                                        rdfs:subClassOf :Fasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#FasilitasDisabilitas
l0122006-l0122056-project:FasilitasDisabilitas rdf:type owl:Class ;
                                               owl:equivalentClass [ owl:intersectionOf ( :Fasilitas
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty l0122006-l0122056-project:melayaniTujuan ;
                                                                                            owl:someValuesFrom l0122006-l0122056-project:Khusus
                                                                                          ]
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty l0122006-l0122056-project:aksesDisabilitas ;
                                                                                            owl:hasValue "true"^^xsd:boolean
                                                                                          ]
                                                                                        ) ;
                                                                     rdf:type owl:Class
                                                                   ] ;
                                               rdfs:subClassOf :Fasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#FasilitasEdukasi
l0122006-l0122056-project:FasilitasEdukasi rdf:type owl:Class ;
                                           owl:equivalentClass [ owl:intersectionOf ( :Fasilitas
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty l0122006-l0122056-project:melayaniTujuan ;
                                                                                        owl:someValuesFrom l0122006-l0122056-project:Edukasi
                                                                                      ]
                                                                                    ) ;
                                                                 rdf:type owl:Class
                                                               ] ;
                                           rdfs:subClassOf :Fasilitas .


###  http://www.semanticweb.org/acer/ontologies/2025/10/L0122006-L0122056-Project#Gunung
